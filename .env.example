# PawCare Platform Environment Configuration

# Supabase (Optional for local testing - fallbacks gracefully to in-memory/local storage mode)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional AI Assistance (Gemini API for enhanced conversational explanation and optional image analysis)
# Can also be routed via Supabase Edge Function to avoid client exposure
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Optional Google Places API (for Clinic Discovery)
# Note: PawCare automatically uses OpenStreetMap / Overpass Turbo live verified clinics by default without needing an API key!
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
